# Copy this file to .env and adjust as needed. All values shown are defaults.
# Never put real personal paths/IPs/hostnames in this file if you plan to
# share your config -- .env is gitignored specifically so this stays local.

BROKKR_OLLAMA_URL=http://127.0.0.1:11434
BROKKR_DEFAULT_MODEL=qwen2.5-coder:7b
BROKKR_DATA_DIR=data
BROKKR_LOG_DIR=logs

# Bounds remembered context so accumulated notes cannot grow prompts forever.
BROKKR_MEMORY_MAX_NOTES=20

# --- Sandbox (Docker) ----------------------------------------------------
BROKKR_SANDBOX_IMAGE=brokkr-sandbox:latest
# Host directory bind-mounted into the sandbox as /workspace -- the ONLY
# thing the sandboxed command can see of your real filesystem.
BROKKR_SANDBOX_WORKDIR_HOST=~/brokkr-workspace
# none = no network access from inside the sandbox (default, safest).
# bridge = normal outbound network access -- treat as a separate, higher
# risk class, not a casual toggle.
BROKKR_SANDBOX_NETWORK=none
BROKKR_SANDBOX_CPU_LIMIT=4
BROKKR_SANDBOX_MEMORY_LIMIT=2g
BROKKR_SANDBOX_PIDS_LIMIT=256
BROKKR_SANDBOX_COMMAND_TIMEOUT_SECONDS=30
BROKKR_SANDBOX_IDLE_RESET_MINUTES=60

# --- Approval memory -------------------------------------------------------
# off (default) = only exact-match commands are ever auto-approved.
# on = allows creating explicit template/pattern approval rules too --
# see docs/approval-matching.md before turning this on.
BROKKR_APPROVAL_TEMPLATE_MATCHING=off
